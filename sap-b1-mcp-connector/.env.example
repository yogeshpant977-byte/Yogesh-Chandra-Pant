# ---- SAP B1 Service Layer (required) ----
B1SL_BASE_URL=https://<host>:50000/b1s/v1
B1_COMPANY_DB=ZZZ_HPL_LIVE_29082026
# A dedicated integration user, scoped to only what's needed — not a
# personal login. Never commit real values here; put them in a local
# untracked .env instead.
B1_USERNAME=<service layer user>
B1_PASSWORD=<service layer password>
# SAP B1 Service Layer is usually self-signed internally -> false.
# Set true only when Service Layer has a real CA-signed certificate.
B1SL_TLS_REJECT_UNAUTHORIZED=false
# Safety switch: when true, everything except master data (Business
# Partners/Items) is created as a Draft, not posted live to the ledger.
B1SL_POST_AS_DRAFT=true

# ---- SAP HANA direct DB access (optional) ----
# Only needed for direct SQL queries (reports, UDT reads, joins the
# Service Layer can't do easily). Leave HANA_ENABLED=false to skip it.
HANA_ENABLED=false
HANA_HOST=<hana host>
HANA_PORT=30015
# Ideally a read-only / app-specific DB user, not SYSTEM, in production.
HANA_USER=<hana user>
HANA_PASSWORD=<hana password>
# Same as B1_COMPANY_DB — SAP B1 on HANA uses the company DB as the schema.
HANA_SCHEMA=ZZZ_HPL_LIVE_29082026

# ---- Object types allowed to post LIVE regardless of B1SL_POST_AS_DRAFT ----
SL_LIVE_OBJECT_TYPES=BusinessPartners,Items
